<div class="container-fluid">
  <% if flash[:message] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= flash[:message] %>
      <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  <% end %>
  
  <% if flash[:error] %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= flash[:error] %>
      <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3>Запуск задач парсинга</h3>
        </div>
        <div class="card-body">
          <%= form_tag start_task_parser_control_admin_index_path, method: :post, multipart: true, data: { turbo: false }, class: "parser-start-form" do %>
            <div class="form-group">
              <%= label_tag :task_type, "Тип задачи", class: "form-label" %>
              <%= select_tag :task_type, 
                  options_for_select([
                    ['Категории', 'categories'],
                    ['Продукты', 'products'],
                    ['Хиты продаж', 'bestsellers'],
                    ['Популярные категории', 'popular_categories'],
                    ['Картинки категорий', 'category_images'],
                    ['Картинки продуктов', 'product_images'],
                    ['Расширенные атрибуты продуктов (все)', 'extended_attributes'],
                    ['Курсы валют', 'currency_rates'],
                    ['Проверка отсутствующих картинок', 'fix_missing_images'],
                    ['Импорт атрибутов из файла (JSON)', 'extended_attrs_import'],
                    ['Загрузка атрибутов по списку SKU', 'extended_attributes_by_skus'],
                    ['Импорт товаров по списку SKU + time_ikea_id', 'import_products_by_skus'],
                    ['Восполнение ссылок на картинки', 'recover_missing_images'],
                    ['Актуализация вариантов (цвета/размеры)', 'update_product_variants'],
                    ['Полное обновление всех картинок (WebP)', 'update_all_product_images'],
                    ['Генерация preview-картинок (миниатюры)', 'generate_product_image_previews'],
                    ['Оптимизация картинок главной (WebP ≤ 200KB)', 'optimize_home_banner_images'],
                    ['Восполнение недостающего веса', 'recover_missing_weights'],
                    ['Восполнение размеров упаковки (measurements_modal)', 'recover_missing_packaging_dimensions'],
                    ['Восстановление битых картинок (по логу/SKU)', 'recover_broken_product_images'],
                    ['Полная актуализация категории / всего каталога', 'refresh_category_catalog'],
                    ['Актуализация категории (список с LT)', 'refresh_category_lt'],
                    ['Сбор category related_products (1-й/последний SKU)', 'harvest_category_related_products'],
                    ['Актуализация одного товара по SKU (LT/PL)', 'refresh_product_lt'],
                    ['Переиндексация фильтров (одна категория)', 'category_filters_one'],
                    ['Слияние фильтров потомков в родителя', 'merge_parent_category_filters'],
                    ['Сбор серий (f-series) из товаров категории', 'rebuild_category_fseries_filters'],
                    ['Фильтры с LT (категория + потомки)', 'refresh_category_filters_lt'],
                    ['Цены и остатки PL (все SKU или один)', 'pl_prices_stock'],
                    ['Подсчёт: битая ВГХ упаковки', 'count_broken_packaging_dimensions'],
                    ['Подсчёт: битые картинки товара', 'count_broken_product_images'],
                    ['Подсчёт: подозрительный польский текст', 'count_broken_product_translations'],
                    ['Восстановление переводов (LT / AI)', 'recover_broken_product_translations']
                  ]),
                  { prompt: 'Выберите тип задачи', class: "form-control", required: true, id: "task_type_select" } %>
            </div>
            
            <div class="form-group" id="limit_field">
              <%= label_tag :limit, "Лимит записей (необязательно)", class: "form-label" %>
              <%= number_field_tag :limit, nil, class: "form-control", placeholder: "Оставьте пустым для без ограничений", min: 1 %>
            </div>

            <div class="form-group d-none" id="recover_missing_weights_field">
              <%= hidden_field_tag :only_missing_weight, "0" %>
              <div class="custom-control custom-checkbox">
                <%= check_box_tag :only_missing_weight, "1", true, class: "custom-control-input", id: "only_missing_weight_checkbox" %>
                <%= label_tag :only_missing_weight_checkbox, "Только товары без веса (поле weight пустое)", class: "custom-control-label" %>
              </div>
              <small class="form-text text-muted">Рекомендуется оставить включённым. Если снять галочку, пойдут запросы по всем товарам в базе.</small>

              <div class="mt-3">
                <%= label_tag :sku, "SKU одного товара (необязательно)", class: "form-label" %>
                <%= text_field_tag :sku, nil, class: "form-control", placeholder: "Например: 60611111 или 606.111.11" %>
              </div>

              <div class="mt-3">
                <%= label_tag :skus, "Список SKU (необязательно)", class: "form-label" %>
                <%= text_area_tag :skus, nil, class: "form-control", rows: 3, placeholder: "Через пробел/запятую/новую строку: 60611111, 90507818" %>
              </div>

              <div class="mt-3">
                <%= label_tag :recover_category_ikea_id, "IKEA ID категории (необязательно)", class: "form-label" %>
                <%= text_field_tag :recover_category_ikea_id, nil, class: "form-control", placeholder: "Например: 20515" %>
                <small class="form-text text-muted">Можно комбинировать: SKU + категория + only_missing_weight + limit.</small>
              </div>
            </div>

            <div class="form-group d-none" id="recover_missing_packaging_dimensions_field">
              <%= hidden_field_tag :only_missing_packaging_dimensions, "0" %>
              <div class="custom-control custom-checkbox">
                <%= check_box_tag :only_missing_packaging_dimensions, "1", true, class: "custom-control-input", id: "only_missing_packaging_dimensions_checkbox" %>
                <%= label_tag :only_missing_packaging_dimensions_checkbox, "Только товары без полной тройки размеров упаковки в API (size)", class: "custom-control-label" %>
              </div>
              <small class="form-text text-muted">Иначе — повторный парсинг по всем товарам с URL (осторожно с лимитом). Используется ExtendedAttributesFetchService + fallback PL при отсутствии LT.</small>

              <div class="mt-3">
                <%= label_tag :packaging_recover_sku, "SKU одного товара (необязательно)", class: "form-label" %>
                <%= text_field_tag :packaging_recover_sku, nil, class: "form-control", placeholder: "Например: 60611111" %>
              </div>

              <div class="mt-3">
                <%= label_tag :packaging_recover_skus, "Список SKU (необязательно)", class: "form-label" %>
                <%= text_area_tag :packaging_recover_skus, nil, class: "form-control", rows: 3, placeholder: "Через пробел/запятую/новую строку" %>
              </div>

              <div class="mt-3">
                <%= label_tag :packaging_recover_category_ikea_id, "IKEA ID категории (необязательно)", class: "form-label" %>
                <%= text_field_tag :packaging_recover_category_ikea_id, nil, class: "form-control", placeholder: "Например: 20515" %>
              </div>
            </div>

            <div class="form-group d-none" id="recover_broken_product_translations_field">
              <%= hidden_field_tag :translation_only_suspected, "0" %>
              <div class="custom-control custom-checkbox">
                <%= check_box_tag :translation_only_suspected, "1", true, class: "custom-control-input", id: "translation_only_suspected_checkbox" %>
                <%= label_tag :translation_only_suspected_checkbox, "Только товары с подозрительным польским в API (как в подсчёте)", class: "custom-control-label" %>
              </div>
              <small class="form-text text-muted">
                Если снять галочку, джоба прогонит расширенные атрибуты по всем товарам в выборке (может быть очень долго и нагрузочно).
              </small>

              <div class="mt-3">
                <%= label_tag :translation_recover_sku, "SKU одного товара (необязательно)", class: "form-label" %>
                <%= text_field_tag :translation_recover_sku, nil, class: "form-control", placeholder: "Например: 60611111" %>
              </div>

              <div class="mt-3">
                <%= label_tag :translation_recover_skus, "Список SKU (необязательно)", class: "form-label" %>
                <%= text_area_tag :translation_recover_skus, nil, class: "form-control", rows: 3, placeholder: "Через пробел/запятую/новую строку" %>
              </div>

              <div class="mt-3">
                <%= label_tag :translation_recover_category_ikea_id, "IKEA ID категории (необязательно)", class: "form-label" %>
                <%= text_field_tag :translation_recover_category_ikea_id, nil, class: "form-control", placeholder: "Например: 20515" %>
                <small class="form-text text-muted">
                  Сначала берётся русский текст с LT; если LT недоступен — данные с PL и перевод через TranslationService (в т.ч. OpenAI).
                </small>
              </div>
            </div>

            <div class="form-group" id="threads_field">
              <%= label_tag :threads, "Количество потоков", class: "form-label" %>
              <%= number_field_tag :threads, 2, class: "form-control", min: 1, max: 10, placeholder: "Рекомендуется 2-5" %>
              <small class="form-text text-muted">Увеличение потоков ускоряет работу, но повышает нагрузку на сервер и риск блокировки по IP.</small>
            </div>

            <div class="form-group d-none" id="pl_prices_stock_sku_field">
              <%= label_tag :pl_prices_stock_sku, "Только этот SKU (необязательно)", class: "form-label" %>
              <%= text_field_tag :pl_prices_stock_sku, nil, class: "form-control", placeholder: "Например: 19485139 или 194.851.39" %>
              <small class="form-text text-muted">Пустое поле — обход всех товаров с непустым SKU, как раньше. Для проверки джобы укажите один артикул из базы.</small>
            </div>

            <div class="form-group d-none" id="reset_field">
              <div class="custom-control custom-checkbox">
                <%= check_box_tag :reset, '1', false, class: "custom-control-input", id: "reset_checkbox" %>
                <%= label_tag :reset_checkbox, "Сбросить прогресс и начать сначала", class: "custom-control-label" %>
              </div>
              <small class="form-text text-muted">Если отмечено, джоба начнет обработку с первого ID, а не с последнего сохраненного.</small>

              <div class="custom-control custom-checkbox mt-2" id="cleanup_container">
                <%= check_box_tag :cleanup, '1', true, class: "custom-control-input", id: "cleanup_checkbox" %>
                <%= label_tag :cleanup_checkbox, "Полная очистка хранилища (Garbage Collection) в конце", class: "custom-control-label" %>
              </div>
              <small class="form-text text-muted" id="cleanup_help">В конце задачи будут удалены ВСЕ файлы из папки продуктов, на которые нет ссылок в базе данных.</small>
            </div>

            <div class="form-group d-none" id="extra_data_field">
              <%= label_tag :extra_data, "Список SKU (через пробел или запятую)", class: "form-label", id: "extra_data_main_label" %>
              <%= text_area_tag :extra_data, nil, class: "form-control", rows: 5, placeholder: "Например: 123.456.78, 987.654.32", id: "extra_data_textarea" %>
              <small id="category_filters_one_hint" class="form-text text-muted d-none">
                Переиндексация фильтров одной категории: укажите <code>ikea_id</code> (одна строка) или JSON.
                Выборочно: <code>{"ikea_id":"20515","parameters":["f-series"]}</code> (коллекции = <code>f-series</code>).
                Только один товар: добавьте <code>"product_id":123</code>. Без <code>parameters</code> — все фильтры.
              </small>
              <small id="merge_parent_category_filters_hint" class="form-text text-muted d-none">
                В <code>available_filters</code> родителя объединяются значения фильтров (в т.ч. <code>f-series</code>) из всех потомков.
                Поле ниже оставьте пустым — обработка всех категорий с дочерними. Иначе одна строка <code>ikea_id</code> или JSON <code>{"ikea_id":"20515"}</code>.
              </small>
              <small id="rebuild_category_fseries_filters_hint" class="form-text text-muted d-none">
                Сканирует товары категории и всего поддерева: <code>collection</code>, атрибуты Seria/Серия, заголовки.
                Обновляет <code>f-series</code> без дублей, в <code>name</code> без префикса «Серия ». Пример: <code>hs001</code> или <code>{"ikea_id":"hs001"}</code>.
              </small>
              <small id="refresh_category_filters_lt_hint" class="form-text text-muted d-none">
                Запрос к LT search IKEA: обновляет <code>available_filters</code> (цвет, свойства, материал, размер, серия и др., без <code>f-type</code>).
                Пустое поле — все категории в БД; иначе <code>ikea_id</code> или <code>{"ikea_id":"20515"}</code>. Для ветки включите «включая потомков».
              </small>
              <small id="refresh_category_catalog_hint" class="form-text text-muted d-none">
                Единый процесс: обновляет состав категории, товары, русские атрибуты и ВГХ (LT, при отсутствии — PL + перевод),
                загружает все рабочие ненулевые фасеты IKEA, синхронизирует точные связи SKU с фильтрами и сбрасывает кеш категории.
                Укажите <code>ikea_id</code> либо оставьте поле пустым для всех доступных категорий.
              </small>
              <div class="mt-2" id="extra_data_sku_file_block">
                <%= label_tag :sku_file_path, "ИЛИ путь к файлу со списком SKU на сервере", class: "form-label" %>
                <%= text_field_tag :sku_file_path, nil, class: "form-control", placeholder: "/absolute/path/to/file.txt" %>
              </div>
            </div>

            <div class="form-group d-none" id="merge_parent_category_filters_field">
              <%= hidden_field_tag :merge_parent_reindex, "0" %>
              <div class="custom-control custom-checkbox">
                <%= check_box_tag :merge_parent_reindex, "1", true, class: "custom-control-input", id: "merge_parent_reindex_checkbox" %>
                <%= label_tag :merge_parent_reindex_checkbox, "После слияния поставить переиндексацию фильтров этой категории (очередь)", class: "custom-control-label" %>
              </div>
              <small class="form-text text-muted">Снимите галочку, если нужно только обновить JSON <code>available_filters</code> без постановки ReindexCategoryFiltersJob.</small>
            </div>

            <div class="form-group d-none" id="rebuild_category_fseries_filters_field">
              <%= hidden_field_tag :rebuild_fseries_reindex, "0" %>
              <%= hidden_field_tag :rebuild_fseries_propagate, "0" %>
              <div class="custom-control custom-checkbox">
                <%= check_box_tag :rebuild_fseries_propagate, "1", true, class: "custom-control-input", id: "rebuild_fseries_propagate_checkbox" %>
                <%= label_tag :rebuild_fseries_propagate_checkbox, "Записать тот же список f-series во все категории поддерева (для переиндексации товаров в дочерних)", class: "custom-control-label" %>
              </div>
              <div class="custom-control custom-checkbox mt-2">
                <%= check_box_tag :rebuild_fseries_reindex, "1", true, class: "custom-control-input", id: "rebuild_fseries_reindex_checkbox" %>
                <%= label_tag :rebuild_fseries_reindex_checkbox, "После обновления поставить переиндексацию f-series по всему поддереву", class: "custom-control-label" %>
              </div>
            </div>

            <div class="form-group d-none" id="refresh_category_filters_lt_field">
              <%= hidden_field_tag :lt_filters_include_descendants, "0" %>
              <%= hidden_field_tag :lt_filters_reindex, "0" %>
              <%= hidden_field_tag :lt_filters_ensure_series, "0" %>
              <div class="custom-control custom-checkbox">
                <%= check_box_tag :lt_filters_include_descendants, "1", true, class: "custom-control-input", id: "lt_filters_include_descendants_checkbox" %>
                <%= label_tag :lt_filters_include_descendants_checkbox, "Обработать все вложенные дочерние категории", class: "custom-control-label" %>
              </div>
              <div class="custom-control custom-checkbox mt-2">
                <%= check_box_tag :lt_filters_reindex, "1", true, class: "custom-control-input", id: "lt_filters_reindex_checkbox" %>
                <%= label_tag :lt_filters_reindex_checkbox, "После обновления JSON поставить переиндексацию фильтров категории", class: "custom-control-label" %>
              </div>
              <div class="custom-control custom-checkbox mt-2">
                <%= check_box_tag :lt_filters_ensure_series, "1", true, class: "custom-control-input", id: "lt_filters_ensure_series_checkbox" %>
                <%= label_tag :lt_filters_ensure_series_checkbox, "Дополнительно собрать f-series из товаров (если нет в ответе LT)", class: "custom-control-label" %>
              </div>
            </div>

            <div class="form-group d-none" id="webp_image_search_field">
              <%= label_tag :category_ikea_id, "IKEA ID категории (только товары из неё)", class: "form-label" %>
              <%= text_field_tag :category_ikea_id, nil, class: "form-control", placeholder: "Например: 20515 — оставьте пустым для всех категорий" %>
              <small class="form-text text-muted">Учитываются товары с основной категорией <code>category_id</code> и товары, привязанные через <code>category_products</code>. Сочетается с лимитом, списком SKU и фрагментом пути картинки.</small>

              <div class="mt-3">
                <%= label_tag :image_contains, "Фрагмент пути или URL картинки", class: "form-label" %>
                <%= text_field_tag :image_contains, nil, class: "form-control", placeholder: "Например: PH194376, /images/products/, ikea.com/lt/..." %>
                <small class="form-text text-muted">Без регистра. Ищется в JSON полей <code>local_images</code> и <code>images</code>. В массовом режиме по-прежнему только товары с .jpg/.jpeg/.png в локальных путях; со списком SKU — фильтр накладывается на указанные артикулы.</small>
              </div>

              <div class="mt-3">
                <%= label_tag :images_limit, "Максимум картинок на один товар (с сайта IKEA)", class: "form-label" %>
                <%= number_field_tag :images_limit, nil, class: "form-control", min: 1, placeholder: "Пусто = все найденные на странице товара" %>
              </div>
            </div>

            <div class="form-group d-none" id="extra_file_field">
              <%= label_tag :extra_file, "Файл с данными", class: "form-label" %>
              <%= file_field_tag :extra_file, class: "form-control-file" %>
              <small class="form-text text-muted">Для импорта расширенных атрибутов выберите JSON или JSONL файл.</small>
            </div>
            
            <%= submit_tag "Запустить", class: "btn btn-primary", data: { disable_with: "Запускается..." } %>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3>Активные задачи <span class="badge badge-info" id="tasks-count"><%= @running_tasks.count %></span></h3>
        </div>
        <div class="card-body" id="active-tasks-container">
          <% if @running_tasks.any? %>
            <table class="table">
              <thead>
                <tr>
                  <th>Тип</th>
                  <th>Обработано</th>
                  <th>Действие</th>
                </tr>
              </thead>
              <tbody id="active-tasks-tbody">
                <% @running_tasks.each do |task| %>
                  <tr data-task-id="<%= task.id %>">
                    <td>
                      <%= {
                        'categories' => 'Категории',
                        'products' => 'Продукты',
                        'bestsellers' => 'Хиты продаж',
                        'popular_categories' => 'Популярные категории',
                        'category_images' => 'Картинки категорий',
                        'product_images' => 'Картинки продуктов',
                        'extended_attributes' => 'Расширенные атрибуты продуктов',
                        'currency_rates' => 'Курсы валют',
                        'category_filters' => 'Переиндексация фильтров категорий',
                        'extended_attrs_import' => 'Импорт расширенных атрибутов (JSON)',
                        'fix_missing_images' => 'Проверка отсутствующих картинок',
                        'extended_attributes_by_skus' => 'Загрузка атрибутов по списку SKU',
                        'import_products_by_skus' => 'Импорт товаров по SKU + time_ikea_id',
                        'recover_missing_images' => 'Восполнение ссылок на картинки',
                        'update_product_variants' => 'Актуализация вариантов',
                        'update_all_product_images' => 'Обновление всех картинок (WebP)',
                        'generate_product_image_previews' => 'Генерация preview-картинок',
                        'optimize_home_banner_images' => 'Оптимизация картинок главной (WebP ≤ 200KB)',
                        'recover_missing_weights' => 'Восполнение недостающего веса',
                        'recover_missing_packaging_dimensions' => 'Восполнение размеров упаковки',
                        'recover_broken_product_images' => 'Восстановление битых картинок',
                        'refresh_category_catalog' => 'Полная актуализация категории',
                        'refresh_category_lt' => 'Актуализация категории (LT)',
                        'harvest_category_related_products' => 'Сбор category related_products',
                        'refresh_product_lt' => 'Актуализация товара (SKU)',
                        'category_filters_one' => 'Фильтры категории (одна)',
                        'merge_parent_category_filters' => 'Слияние фильтров в родителя',
                        'rebuild_category_fseries_filters' => 'Сбор серий (f-series)',
                        'refresh_category_filters_lt' => 'Фильтры с LT',
                        'pl_prices_stock' => 'Цены и остатки (PL)',
                        'count_broken_packaging_dimensions' => 'Подсчёт: ВГХ упаковки',
                        'count_broken_product_images' => 'Подсчёт: битые картинки',
                        'count_broken_product_translations' => 'Подсчёт: польский текст',
                        'recover_broken_product_translations' => 'Восстановление переводов'
                      }[task.task_type] || task.task_type %>
                      <% if task.status == 'pending' %>
                        <span class="badge badge-secondary ml-2">Ожидание</span>
                      <% elsif task.status == 'running' %>
                        <span class="badge badge-primary ml-2">Выполняется</span>
                      <% end %>
                    </td>
                    <td><%= task.processed %> / <%= task.limit || '∞' %></td>
                    <td>
                      <%= form_tag stop_task_parser_control_admin_index_path, method: :post, data: { turbo: false }, style: "display: inline;" do %>
                        <%= hidden_field_tag :task_id, task.id %>
                        <%= submit_tag "Остановить", class: "btn btn-sm btn-danger", data: { disable_with: "Останавливается...", confirm: "Вы уверены, что хотите остановить эту задачу?" } %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted" id="no-tasks-message">Нет активных задач</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-warning">
        <div class="card-header bg-light">
          <h3 class="mb-0">Sidekiq — очистка и перезапуск</h3>
        </div>
        <div class="card-body">
          <p class="text-muted">
            Удаляются джобы из очередей из <code>config/sidekiq.yml</code>, а также наборы <strong>Retry</strong>, <strong>Scheduled</strong> и <strong>Dead</strong>.
            Перезапуск выполняется командой <code>sudo -n systemctl restart …</code> (нужен NOPASSWD для пользователя Puma, обычно <code>deploy</code>).
            Переменная <code>SIDEKIQ_SYSTEMD_UNIT</code> (по умолчанию <code>ikea_back_sidekiq.service</code>).
          </p>
          <div class="row">
            <div class="col-md-6">
              <h5>Только очистить Redis (очереди + retry + scheduled + dead)</h5>
              <%= form_tag sidekiq_purge_queues_parser_control_admin_index_path, method: :post, data: { turbo: false } do %>
                <div class="custom-control custom-checkbox mb-2">
                  <%= check_box_tag :confirm_purge, "1", false, class: "custom-control-input", id: "confirm_purge_cb", required: true %>
                  <%= label_tag :confirm_purge_cb, "Подтверждаю очистку очередей", class: "custom-control-label" %>
                </div>
                <%= button_tag type: "submit", class: "btn btn-warning",
                    data: { confirm: "Удалить все джобы из перечисленных очередей и retry/scheduled/dead?", disable_with: "Очистка…" } do %>
                  Очистить очереди Sidekiq
                <% end %>
              <% end %>
            </div>
            <div class="col-md-6">
              <h5>Очистить и перезапустить воркер (systemd)</h5>
              <%= form_tag sidekiq_purge_and_restart_parser_control_admin_index_path, method: :post, data: { turbo: false } do %>
                <div class="custom-control custom-checkbox mb-2">
                  <%= check_box_tag :confirm_restart, "1", false, class: "custom-control-input", id: "confirm_restart_cb", required: true %>
                  <%= label_tag :confirm_restart_cb, "Подтверждаю очистку и перезапуск Sidekiq", class: "custom-control-label" %>
                </div>
                <%= button_tag type: "submit", class: "btn btn-danger",
                    data: { confirm: "Очистить все очереди Sidekiq и выполнить systemctl restart? Текущие джобы воркера будут прерваны.", disable_with: "Выполняется…" } do %>
                  Очистить и перезапустить Sidekiq
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3>Последние задачи</h3>
        </div>
        <div class="card-body">
          <table class="table">
            <thead>
              <tr>
                <th>Тип</th>
                <th>Статус</th>
                <th>Обработано</th>
                <th>Создано</th>
                <th>Обновлено</th>
                <th>Ошибок</th>
                <th>Начало</th>
                <th>Завершено</th>
                <th>Действие</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_tasks.each do |task| %>
                <tr>
                  <td>
                    <%= {
                      'categories' => 'Категории',
                      'products' => 'Продукты',
                      'bestsellers' => 'Хиты продаж',
                      'popular_categories' => 'Популярные категории',
                      'category_images' => 'Картинки категорий',
                      'product_images' => 'Картинки продуктов',
                      'extended_attributes' => 'Расширенные атрибуты продуктов',
                      'currency_rates' => 'Курсы валют',
                      'category_filters' => 'Переиндексация фильтров категорий',
                      'extended_attrs_import' => 'Импорт расширенных атрибутов (JSON)',
                      'fix_missing_images' => 'Проверка отсутствующих картинок',
                      'extended_attributes_by_skus' => 'Загрузка атрибутов по списку SKU',
                      'import_products_by_skus' => 'Импорт товаров по SKU + time_ikea_id',
                      'recover_missing_weights' => 'Восполнение недостающего веса',
                      'recover_missing_packaging_dimensions' => 'Восполнение размеров упаковки',
                      'update_all_product_images' => 'Обновление всех картинок (WebP)',
                      'generate_product_image_previews' => 'Генерация preview-картинок',
                      'optimize_home_banner_images' => 'Оптимизация картинок главной (WebP ≤ 200KB)',
                      'recover_broken_product_images' => 'Восстановление битых картинок',
                      'refresh_category_catalog' => 'Полная актуализация категории',
                      'refresh_category_lt' => 'Актуализация категории (LT)',
                      'harvest_category_related_products' => 'Сбор category related_products',
                      'refresh_product_lt' => 'Актуализация товара (SKU)',
                      'category_filters_one' => 'Фильтры категории (одна)',
                      'merge_parent_category_filters' => 'Слияние фильтров в родителя',
                      'rebuild_category_fseries_filters' => 'Сбор серий (f-series)',
                      'refresh_category_filters_lt' => 'Фильтры с LT',
                      'pl_prices_stock' => 'Цены и остатки (PL)',
                      'count_broken_packaging_dimensions' => 'Подсчёт: ВГХ упаковки',
                      'count_broken_product_images' => 'Подсчёт: битые картинки',
                      'count_broken_product_translations' => 'Подсчёт: польский текст',
                      'recover_broken_product_translations' => 'Восстановление переводов'
                    }[task.task_type] || task.task_type %>
                  </td>
                  <td>
                    <span class="badge badge-<%= task.status == 'completed' ? 'success' : task.status == 'failed' ? 'danger' : 'primary' %>">
                      <%= task.status %>
                    </span>
                  </td>
                  <td><%= task.processed %></td>
                  <td><%= task.created %></td>
                  <td><%= task.updated %></td>
                  <td><%= task.error_count %></td>
                  <td><%= task.started_at&.strftime('%d.%m.%Y %H:%M') %></td>
                  <td><%= task.completed_at&.strftime('%d.%m.%Y %H:%M') %></td>
                  <td>
                    <% if %w[extended_attrs_import update_all_product_images].include?(task.task_type) && task.status == 'failed' %>
                      <%= form_tag resume_task_parser_control_admin_index_path, method: :post, data: { turbo: false }, style: "display: inline;" do %>
                        <%= hidden_field_tag :task_id, task.id %>
                        <%= submit_tag "Продолжить", class: "btn btn-sm btn-outline-primary" %>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  // Переменная для хранения интервала обновления
  let updateInterval = null;
  let consecutiveEmptyUpdates = 0; // Счетчик пустых обновлений
  let currentUpdateInterval = 2000; // Текущий интервал обновления в миллисекундах
  
  // Функция для экранирования HTML
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  // Функция для обновления списка активных задач
  function updateActiveTasks() {
    const container = document.getElementById('active-tasks-container');
    
    // Если контейнер не найден, значит мы не на этой странице - останавливаем обновление
    if (!container) {
      if (updateInterval) {
        clearInterval(updateInterval);
        updateInterval = null;
      }
      return;
    }
    
    fetch('<%= active_tasks_parser_control_admin_index_path %>', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'same-origin'
    })
    .then(response => response.json())
    .then(data => {
      // Повторно проверяем существование элементов (на случай навигации во время запроса)
      const container = document.getElementById('active-tasks-container');
      if (!container) {
        if (updateInterval) {
          clearInterval(updateInterval);
          updateInterval = null;
        }
        return;
      }
      
      const tbody = document.getElementById('active-tasks-tbody');
      const noTasksMessage = document.getElementById('no-tasks-message');
      const tasksCount = document.getElementById('tasks-count');
      
      // Обновляем счетчик
      if (tasksCount) {
        tasksCount.textContent = data.tasks.length;
      }
      
      // Если нет активных задач, увеличиваем счетчик пустых обновлений
      if (data.tasks.length === 0) {
        consecutiveEmptyUpdates++;
      } else {
        consecutiveEmptyUpdates = 0; // Сбрасываем счетчик, если есть задачи
      }
      
      if (data.tasks.length === 0) {
        // Нет активных задач
        if (tbody) {
          tbody.innerHTML = '';
        }
        if (!noTasksMessage) {
          const p = document.createElement('p');
          p.className = 'text-muted';
          p.id = 'no-tasks-message';
          p.textContent = 'Нет активных задач';
          container.innerHTML = '';
          container.appendChild(p);
        }
      } else {
        // Есть активные задачи
        if (noTasksMessage) {
          noTasksMessage.remove();
        }
        
        // Создаем таблицу, если её нет
        if (!tbody) {
          const table = document.createElement('table');
          table.className = 'table';
          table.innerHTML = `
            <thead>
              <tr>
                <th>Тип</th>
                <th>Обработано</th>
                <th>Действие</th>
              </tr>
            </thead>
            <tbody id="active-tasks-tbody"></tbody>
          `;
          container.innerHTML = '';
          container.appendChild(table);
        }
        
        const newTbody = document.getElementById('active-tasks-tbody');
        newTbody.innerHTML = '';
        
        // Добавляем задачи
        data.tasks.forEach(function(task) {
          const row = document.createElement('tr');
          row.setAttribute('data-task-id', task.id);
          
          const taskTypeLabel = {
            'categories': 'Категории',
            'products': 'Продукты',
            'bestsellers': 'Хиты продаж',
            'popular_categories': 'Популярные категории',
            'category_images': 'Картинки категорий',
            'product_images': 'Картинки продуктов',
            'extended_attributes': 'Расширенные атрибуты продуктов',
            'currency_rates': 'Курсы валют',
            'category_filters': 'Переиндексация фильтров категорий',
            'extended_attrs_import': 'Импорт расширенных атрибутов (JSON)',
            'fix_missing_images': 'Проверка отсутствующих картинок',
            'extended_attributes_by_skus': 'Загрузка атрибутов по списку SKU',
            'import_products_by_skus': 'Импорт товаров по SKU + time_ikea_id',
            'recover_missing_weights': 'Восполнение недостающего веса',
            'recover_missing_packaging_dimensions': 'Восполнение размеров упаковки',
            'update_all_product_images': 'Обновление всех картинок (WebP)',
            'generate_product_image_previews': 'Генерация preview-картинок',
            'optimize_home_banner_images': 'Оптимизация картинок главной (WebP ≤ 200KB)',
            'recover_broken_product_images': 'Восстановление битых картинок',
            'refresh_category_catalog': 'Полная актуализация категории',
            'refresh_category_lt': 'Актуализация категории (LT)',
            'harvest_category_related_products': 'Сбор category related_products',
            'refresh_product_lt': 'Актуализация товара (SKU)',
            'category_filters_one': 'Фильтры категории (одна)',
            'merge_parent_category_filters': 'Слияние фильтров в родителя',
            'rebuild_category_fseries_filters': 'Сбор серий (f-series)',
            'refresh_category_filters_lt': 'Фильтры с LT',
            'pl_prices_stock': 'Цены и остатки (PL)',
            'count_broken_packaging_dimensions': 'Подсчёт: ВГХ упаковки',
            'count_broken_product_images': 'Подсчёт: битые картинки',
            'count_broken_product_translations': 'Подсчёт: польский текст',
            'recover_broken_product_translations': 'Восстановление переводов'
          }[task.task_type] || task.task_type;
          
          const limitText = task.limit ? task.limit : '∞';
          const statusBadge = task.status === 'pending' 
            ? '<span class="badge badge-secondary ml-2">Ожидание</span>'
            : task.status === 'running'
            ? '<span class="badge badge-primary ml-2">Выполняется</span>'
            : '';
          
          // Получаем authenticity_token из мета-тега или формы
          const authToken = document.querySelector('meta[name="csrf-token"]')?.content || 
                          document.querySelector('input[name="authenticity_token"]')?.value || '';
          
          row.innerHTML = `
            <td>${escapeHtml(taskTypeLabel)}${statusBadge}</td>
            <td>${task.processed} / ${limitText}</td>
            <td>
              <form action="<%= stop_task_parser_control_admin_index_path %>" method="post" style="display: inline;" data-turbo="false">
                <input type="hidden" name="authenticity_token" value="${authToken}">
                <input type="hidden" name="task_id" value="${task.id}">
                <input type="submit" value="Остановить" class="btn btn-sm btn-danger" 
                       data-disable-with="Останавливается..." 
                       data-confirm="Вы уверены, что хотите остановить эту задачу?">
              </form>
            </td>
          `;
          
          newTbody.appendChild(row);
        });
      }
      
      // Оптимизация: если нет активных задач долгое время, увеличиваем интервал
      // Если нет задач более 10 раз подряд (20 секунд при интервале 2 сек), останавливаем обновление
      // Если нет задач более 3 раз подряд (6 секунд), увеличиваем интервал до 10 секунд
      let newInterval = null;
      
      if (consecutiveEmptyUpdates > 10) {
        // Останавливаем обновление, если долго нет задач
        newInterval = null;
      } else if (consecutiveEmptyUpdates > 3) {
        // Увеличиваем интервал до 10 секунд, если нет задач
        newInterval = 10000;
      } else {
        // Возвращаем быстрый интервал (2 секунды)
        newInterval = 2000;
      }
      
      // Пересоздаем интервал только если он изменился
      if (newInterval !== currentUpdateInterval) {
        if (updateInterval) {
          clearInterval(updateInterval);
          updateInterval = null;
        }
        currentUpdateInterval = newInterval;
        if (newInterval !== null) {
          updateInterval = setInterval(updateActiveTasks, newInterval);
        }
      }
    })
    .catch(error => {
      console.error('Ошибка при обновлении списка задач:', error);
    });
  }
  
  // Функция для запуска обновления
  function startUpdating() {
    // Останавливаем предыдущий интервал, если он есть
    if (updateInterval) {
      clearInterval(updateInterval);
      updateInterval = null;
    }
    
    // Сбрасываем счетчик пустых обновлений и интервал
    consecutiveEmptyUpdates = 0;
    currentUpdateInterval = 2000;
    
    // Проверяем, что мы на нужной странице
    const container = document.getElementById('active-tasks-container');
    if (!container) {
      return;
    }
    
    // Обновляем сразу
    updateActiveTasks();
    
    // Запускаем интервал (начинаем с быстрого обновления)
    updateInterval = setInterval(updateActiveTasks, currentUpdateInterval);
  }
  
  // Запускаем обновление при загрузке страницы
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startUpdating);
  } else {
    startUpdating();
  }
  
  // Останавливаем обновление при уходе со страницы
  window.addEventListener('beforeunload', function() {
    if (updateInterval) {
      clearInterval(updateInterval);
      updateInterval = null;
    }
  });
  
  // Останавливаем обновление при навигации через Turbo/Trestle
  document.addEventListener('turbo:before-visit', function() {
    if (updateInterval) {
      clearInterval(updateInterval);
      updateInterval = null;
    }
  });
  
  // Перезапускаем обновление после навигации (если вернулись на эту страницу)
  document.addEventListener('turbo:load', function() {
    const container = document.getElementById('active-tasks-container');
    if (container && !updateInterval) {
      startUpdating();
    }
  });
  
  // Обновляем список после отправки формы запуска задачи
  const startForm = document.querySelector('.parser-start-form');
  if (startForm) {
    const taskSelect = document.getElementById('task_type_select');
    const limitField = document.getElementById('limit_field');
    const threadsField = document.getElementById('threads_field');
    const resetField = document.getElementById('reset_field');
    const cleanupContainer = document.getElementById('cleanup_container');
    const cleanupHelp = document.getElementById('cleanup_help');
    const extraDataField = document.getElementById('extra_data_field');
    const extraFileField = document.getElementById('extra_file_field');
    const webpImageSearchField = document.getElementById('webp_image_search_field');
    const recoverMissingWeightsField = document.getElementById('recover_missing_weights_field');
    const recoverMissingPackagingDimsField = document.getElementById('recover_missing_packaging_dimensions_field');
    const recoverBrokenTranslationsField = document.getElementById('recover_broken_product_translations_field');
    const plPricesStockSkuField = document.getElementById('pl_prices_stock_sku_field');
    const extraDataMainLabel = document.getElementById('extra_data_main_label');
    const extraDataTextarea = document.getElementById('extra_data_textarea');
    const categoryFiltersOneHint = document.getElementById('category_filters_one_hint');
    const mergeParentCategoryFiltersHint = document.getElementById('merge_parent_category_filters_hint');
    const mergeParentCategoryFiltersField = document.getElementById('merge_parent_category_filters_field');
    const rebuildCategoryFseriesFiltersHint = document.getElementById('rebuild_category_fseries_filters_hint');
    const rebuildCategoryFseriesFiltersField = document.getElementById('rebuild_category_fseries_filters_field');
    const refreshCategoryFiltersLtHint = document.getElementById('refresh_category_filters_lt_hint');
    const refreshCategoryFiltersLtField = document.getElementById('refresh_category_filters_lt_field');
    const refreshCategoryCatalogHint = document.getElementById('refresh_category_catalog_hint');
    const extraDataSkuFileBlock = document.getElementById('extra_data_sku_file_block');

    function toggleFields() {
      const task = taskSelect.value;
      
      // Скрываем все
      limitField.classList.remove('d-none');
      threadsField.classList.add('d-none');
      resetField.classList.add('d-none');
      cleanupContainer.classList.add('d-none');
      cleanupHelp.classList.add('d-none');
      extraDataField.classList.add('d-none');
      extraFileField.classList.add('d-none');
      if (webpImageSearchField) webpImageSearchField.classList.add('d-none');
      if (recoverMissingWeightsField) recoverMissingWeightsField.classList.add('d-none');
      if (recoverMissingPackagingDimsField) recoverMissingPackagingDimsField.classList.add('d-none');
      if (recoverBrokenTranslationsField) recoverBrokenTranslationsField.classList.add('d-none');
      if (plPricesStockSkuField) plPricesStockSkuField.classList.add('d-none');
      if (categoryFiltersOneHint) categoryFiltersOneHint.classList.add('d-none');
      if (mergeParentCategoryFiltersHint) mergeParentCategoryFiltersHint.classList.add('d-none');
      if (mergeParentCategoryFiltersField) mergeParentCategoryFiltersField.classList.add('d-none');
      if (rebuildCategoryFseriesFiltersHint) rebuildCategoryFseriesFiltersHint.classList.add('d-none');
      if (rebuildCategoryFseriesFiltersField) rebuildCategoryFseriesFiltersField.classList.add('d-none');
      if (refreshCategoryFiltersLtHint) refreshCategoryFiltersLtHint.classList.add('d-none');
      if (refreshCategoryFiltersLtField) refreshCategoryFiltersLtField.classList.add('d-none');
      if (refreshCategoryCatalogHint) refreshCategoryCatalogHint.classList.add('d-none');
      if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.remove('d-none');
      if (extraDataMainLabel) extraDataMainLabel.textContent = 'Список SKU (через пробел или запятую)';
      if (extraDataTextarea) extraDataTextarea.placeholder = 'Например: 123.456.78, 987.654.32';

      if (task === 'extended_attributes_by_skus' || task === 'import_products_by_skus' || task === 'recover_broken_product_images' || task === 'update_product_variants' || task === 'refresh_category_catalog' || task === 'refresh_category_lt' || task === 'harvest_category_related_products' || task === 'refresh_product_lt' || task === 'category_filters_one' || task === 'merge_parent_category_filters' || task === 'rebuild_category_fseries_filters' || task === 'refresh_category_filters_lt' || task === 'generate_product_image_previews') {
        extraDataField.classList.remove('d-none');
      } else if (task === 'extended_attrs_import') {
        extraFileField.classList.remove('d-none');
        limitField.classList.add('d-none');
      } else if (task === 'update_all_product_images') {
        resetField.classList.remove('d-none');
        threadsField.classList.remove('d-none');
        cleanupContainer.classList.remove('d-none');
        cleanupHelp.classList.remove('d-none');
        extraDataField.classList.remove('d-none');
        if (webpImageSearchField) webpImageSearchField.classList.remove('d-none');
      } else if (task === 'generate_product_image_previews') {
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'Список SKU (необязательно)';
        if (extraDataTextarea) extraDataTextarea.placeholder = 'Пусто = все локальные product webp; иначе список SKU: 60580273, 80489850';
      } else if (task === 'pl_prices_stock' || task === 'refresh_category_lt') {
        threadsField.classList.remove('d-none');
        if (task === 'pl_prices_stock' && plPricesStockSkuField) plPricesStockSkuField.classList.remove('d-none');
      } else if (task === 'recover_missing_weights') {
        if (recoverMissingWeightsField) recoverMissingWeightsField.classList.remove('d-none');
      } else if (task === 'recover_missing_packaging_dimensions') {
        if (recoverMissingPackagingDimsField) recoverMissingPackagingDimsField.classList.remove('d-none');
      } else if (task === 'recover_broken_product_translations') {
        if (recoverBrokenTranslationsField) recoverBrokenTranslationsField.classList.remove('d-none');
      }

      if (task === 'refresh_category_catalog' || task === 'refresh_category_lt') {
        threadsField.classList.remove('d-none');
      }

      if (task === 'refresh_category_catalog') {
        limitField.classList.add('d-none');
        if (refreshCategoryCatalogHint) refreshCategoryCatalogHint.classList.remove('d-none');
        if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.add('d-none');
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'IKEA ID категории (необязательно)';
        if (extraDataTextarea) extraDataTextarea.placeholder = 'Пусто = весь каталог; или 20515; или {"ikea_id":"20515"}';
      } else if (task === 'category_filters_one') {
        limitField.classList.add('d-none');
        if (categoryFiltersOneHint) categoryFiltersOneHint.classList.remove('d-none');
        if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.add('d-none');
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'IKEA ID категории или JSON';
        if (extraDataTextarea) extraDataTextarea.placeholder = '20515 или {"ikea_id":"20515","parameters":["f-series"]}';
      } else if (task === 'merge_parent_category_filters') {
        limitField.classList.add('d-none');
        if (mergeParentCategoryFiltersHint) mergeParentCategoryFiltersHint.classList.remove('d-none');
        if (mergeParentCategoryFiltersField) mergeParentCategoryFiltersField.classList.remove('d-none');
        if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.add('d-none');
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'IKEA ID родителя (необязательно) или JSON';
        if (extraDataTextarea) extraDataTextarea.placeholder = 'Пусто = все родительские категории; или 20515; или {"ikea_id":"20515"}';
      } else if (task === 'rebuild_category_fseries_filters') {
        limitField.classList.add('d-none');
        if (rebuildCategoryFseriesFiltersHint) rebuildCategoryFseriesFiltersHint.classList.remove('d-none');
        if (rebuildCategoryFseriesFiltersField) rebuildCategoryFseriesFiltersField.classList.remove('d-none');
        if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.add('d-none');
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'IKEA ID категории или JSON';
        if (extraDataTextarea) extraDataTextarea.placeholder = 'hs001 или {"ikea_id":"hs001"}';
      } else if (task === 'refresh_category_filters_lt') {
        limitField.classList.add('d-none');
        if (refreshCategoryFiltersLtHint) refreshCategoryFiltersLtHint.classList.remove('d-none');
        if (refreshCategoryFiltersLtField) refreshCategoryFiltersLtField.classList.remove('d-none');
        if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.add('d-none');
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'IKEA ID категории (необязательно) или JSON';
        if (extraDataTextarea) extraDataTextarea.placeholder = 'Пусто = все категории; 20515; {"ikea_id":"20515"}';
      } else if (task === 'refresh_product_lt') {
        if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.add('d-none');
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'SKU товара или JSON';
        if (extraDataTextarea) extraDataTextarea.placeholder = '60580273 или {"sku":"60580273","category_ikea_id":"20515","process_related":true}';
      } else if (task === 'harvest_category_related_products') {
        if (extraDataSkuFileBlock) extraDataSkuFileBlock.classList.add('d-none');
        if (extraDataMainLabel) extraDataMainLabel.textContent = 'IKEA ID категории или JSON';
        if (extraDataTextarea) extraDataTextarea.placeholder = '20515 или {"ikea_id":"20515"}';
      }
    }

    if (taskSelect) {
      taskSelect.addEventListener('change', toggleFields);
      toggleFields(); // Инициализация
    }

    startForm.addEventListener('submit', function() {
      // Сбрасываем счетчик пустых обновлений при запуске новой задачи
      consecutiveEmptyUpdates = 0;
      currentUpdateInterval = 1000; // Быстрое обновление при запуске задачи
      
      // Обновляем через небольшую задержку после отправки формы
      setTimeout(function() {
        const container = document.getElementById('active-tasks-container');
        if (!container) {
          return;
        }
        
        updateActiveTasks();
        // Увеличиваем частоту обновления после запуска задачи (1 секунда)
        if (updateInterval) {
          clearInterval(updateInterval);
        }
        updateInterval = setInterval(updateActiveTasks, currentUpdateInterval);
      }, 500);
    });
  }
})();
</script>
