<div class="container-fluid">
  <div class="row">
    <!-- Актуальные курсы валют -->
    <div class="col-12 mb-4">
      <div class="card">
        <div class="card-header bg-info text-white">
          <h4 class="mb-0">📊 Актуальные курсы валют на <%= Date.today.strftime('%d.%m.%Y') %></h4>
        </div>
        <div class="card-body">
          <% if @current_rates %>
            <div class="row">
              <% ['USD', 'EUR', 'PLN'].each do |currency| %>
                <% rate_key = currency.downcase.to_sym %>
                <% if @current_rates[rate_key] %>
                  <% rate = @current_rates[rate_key] %>
                  <div class="col-md-4">
                    <div class="card h-100">
                      <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                          <% case currency %>
                          <% when 'USD' %>
                            💵 USD (Доллар США)
                          <% when 'EUR' %>
                            💶 EUR (Евро)
                          <% when 'PLN' %>
                            💰 PLN (Польский злотый)
                          <% end %>
                        </h5>
                      </div>
                      <div class="card-body">
                        <table class="table table-sm table-bordered mb-0">
                          <tr>
                            <td>Курс НБ РБ:</td>
                            <td class="text-right"><strong><%= number_with_precision(rate[:nbrb], precision: 4) %> BYN</strong></td>
                          </tr>
                          <tr>
                            <td>Курс с буфером <%= ((@params_info[:buffer] - 1) * 100).to_i %>%:</td>
                            <td class="text-right"><strong class="text-success"><%= number_with_precision(rate[:with_buffer], precision: 4) %> BYN</strong></td>
                          </tr>
                          <tr>
                            <td>Дата курса:</td>
                            <td class="text-right"><%= rate[:date].strftime('%d.%m.%Y') %></td>
                          </tr>
                        </table>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
            <div class="alert alert-info mt-3 mb-0">
              <small>
                <strong>Примечание:</strong> Курсы обновляются раз в сутки из API НБ РБ. 
                К курсу PLN добавляется страховой буфер <%= ((@params_info[:buffer] - 1) * 100).to_i %>% (настройка <code>exchange_rate_buffer</code>).
              </small>
            </div>
          <% else %>
            <div class="alert alert-warning">
              Не удалось загрузить актуальные курсы валют. Проверьте наличие курсов в системе.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <div class="col-md-5">
      <div class="card">
        <div class="card-header">
          <h3>Калькулятор стоимости товара (Новый)</h3>
          <p class="text-muted mb-0">K + доставка PL + весовая логистика РБ → сумма PLN → BYN (курс × <%= @params_info[:buffer] %>)</p>
        </div>
        <div class="card-body">
          <%= form_tag admin.instance_path(PriceCalculator.new(id: 'show')), method: :get, data: { turbo: false } do %>
            <div class="form-group mb-3">
              <%= label_tag :product_price, "Цена товара (PLN)", class: "form-label" %>
              <%= number_field_tag :product_price, params[:product_price], 
                  class: "form-control", step: 0.01, min: 0, required: true, placeholder: "0.00" %>
              <small class="form-text text-muted">
                Брутто цена на сайте IKEA Poland в злотых (PLN)
              </small>
            </div>
            
            <div class="form-group mb-3">
              <%= label_tag :weight, "Вес товара (кг)", class: "form-label" %>
              <%= number_field_tag :weight, params[:weight], 
                  class: "form-control", step: 0.01, min: 0, required: true, placeholder: "0.00" %>
              <small class="form-text text-muted">
                Вес товара в килограммах
              </small>
            </div>
            
            <div class="form-group mb-3">
              <%= label_tag :delivery_pln, "Доставка (PLN), опционально", class: "form-label" %>
              <%= number_field_tag :delivery_pln, params[:delivery_pln],
                  class: "form-control", step: 0.01, min: 0, placeholder: "оставьте пустым — тариф по Польше" %>
              <small class="form-text text-muted">
                Как поле <code>delivery_cost</code> у товара. Если пусто — берётся ступенчатый тариф из <code>poland_delivery_rates</code> (и опция GLS ниже).
              </small>
            </div>

            <div class="form-group mb-3">
              <%= label_tag :use_gls, class: "form-check-label" do %>
                <%= check_box_tag :use_gls, '1', params[:use_gls] == '1', class: "form-check-input" %>
                Использовать пункт отбора GLS (бесплатно до 30 кг) — только если доставка PLN не задана вручную
              <% end %>
            </div>
            
            <div class="form-group mb-3">
              <%= label_tag :date, "Дата курсов валют", class: "form-label" %>
              <%= date_field_tag :date, params[:date] || Date.today, class: "form-control" %>
            </div>
            
            <%= hidden_field_tag :calculate, '1' %>
            <%= submit_tag "Рассчитать", class: "btn btn-primary btn-lg w-100" %>
          <% end %>
        </div>
      </div>
      
      <!-- Описание расчета -->
      <div class="card mt-4">
        <div class="card-header">
          <h5>📋 Формула цены</h5>
        </div>
        <div class="card-body">
          <ol class="mb-3">
            <li class="mb-2">
              <strong>Наценка K</strong> (чем дешевле товар, тем выше K, минимум <%= (@params_info[:min_markup] * 100).round %>%):<br>
              <small class="text-muted">
                <code>K = max(<%= @params_info[:min_markup] %>, <%= @params_info[:target_profit] %> / Цена_PLN − <%= @params_info[:markup_subtrahend] %>)</code>
              </small>
            </li>
            <li class="mb-2">
              <strong>Весовая логистика РБ (WC_BY)</strong>, PLN за кг × вес:<br>
              <small class="text-muted">
                до 20 кг — 16.85; 21–30 кг — 12.81; 31–40 кг — 10.69; свыше 40 кг — 8.58<br>
                (границы и ставки задаются в <code>belarus_delivery_rates</code>)
              </small>
            </li>
            <li class="mb-2">
              <strong>Сумма в PLN:</strong><br>
              <small class="text-muted">
                <code>Цена_PLN × (1 + K) + Доставка_PLN + WC_BY</code><br>
                Доставка — из поля выше (как у товара) или ступенчатый тариф <code>poland_delivery_rates</code> + GLS, если поле пустое.
              </small>
            </li>
            <li class="mb-2">
              <strong>BYN:</strong><br>
              <small class="text-muted">
                <code>round(Сумма_PLN × Курс_PLN_BYN × <%= @params_info[:buffer] %>, 2)</code>
                — множитель <code>exchange_rate_buffer</code> (по умолчанию 1.05).
              </small>
            </li>
          </ol>
          <p class="mb-0 small text-muted">
            <strong>Пример:</strong> 500 PLN, доставка 50 PLN, 15 кг → K = max(10%, 87/500−0.187) = 10%;
            WC_BY = 15×16.85 = 252.75; итого PLN = 500×1.10 + 50 + 252.75 = 852.75.
            В калькуляторе доставка PL берётся по вашим тарифам (для 15 кг это обычно не 50 PLN).
          </p>
        </div>
      </div>
    </div>
    
    <div class="col-md-7">
      <% if @error %>
        <div class="alert alert-danger">
          <strong>Ошибка:</strong> <%= @error %>
        </div>
      <% end %>
      
      <% if @calculation %>
        <div class="card">
          <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Результат расчета</h3>
          </div>
          <div class="card-body">
            <div class="alert alert-success mb-4 text-center">
              <h4 class="alert-heading">Итоговая стоимость:</h4>
              <h1 class="mb-0 text-primary">
                <strong><%= number_to_currency(@calculation[:total_price_byn], unit: 'BYN', format: '%n %u', precision: 2) %></strong>
              </h1>
              <div class="mt-2 text-muted">
                (≈ <%= number_to_currency(@calculation[:total_pln], unit: 'PLN', format: '%n %u', precision: 2) %>)
              </div>
            </div>
            
            <!-- Детализация -->
            <div class="row">
              <div class="col-md-6">
                <h5>Наценка и Коэффициенты:</h5>
                <table class="table table-sm table-bordered mb-4">
                  <tr>
                    <td>Наценка K:</td>
                    <td class="text-right"><strong><%= (@calculation[:markup_k] * 100).round(2) %>%</strong></td>
                  </tr>
                  <tr>
                    <td>Курс PLN (баз):</td>
                    <td class="text-right"><%= number_with_precision(@calculation[:pln_rate], precision: 4) %></td>
                  </tr>
                  <tr>
                    <td>Курс PLN (с буф):</td>
                    <td class="text-right"><strong><%= number_with_precision(@calculation[:pln_rate_with_buffer], precision: 4) %></strong></td>
                  </tr>
                </table>
              </div>
              <div class="col-md-6">
                <h5>Физические параметры:</h5>
                <table class="table table-sm table-bordered mb-4">
                  <tr>
                    <td>Вес товара:</td>
                    <td class="text-right"><%= @calculation[:weight_kg] %> кг</td>
                  </tr>
                  <tr>
                    <td>Пункт отбора:</td>
                    <td class="text-right"><%= params[:use_gls] == '1' ? 'GLS' : 'Курьер/Склад' %></td>
                  </tr>
                </table>
              </div>
            </div>

            <h5>Расчет суммы в PLN:</h5>
            <table class="table table-sm table-bordered mb-4">
              <tr>
                <td>Цена товара:</td>
                <td class="text-right"><%= number_to_currency(@calculation[:product_price_zl], unit: 'PLN', format: '%n %u', precision: 2) %></td>
              </tr>
              <tr>
                <td>Наценка (<%= (@calculation[:markup_k] * 100).round(2) %>%):</td>
                <td class="text-right">+ <%= number_to_currency(@calculation[:product_price_zl] * @calculation[:markup_k], unit: 'PLN', format: '%n %u', precision: 2) %></td>
              </tr>
              <tr>
                <td>Доставка (PLN):</td>
                <td class="text-right">+ <%= number_to_currency(@calculation[:delivery_pln] || @calculation[:poland_delivery_zl], unit: 'PLN', format: '%n %u', precision: 2) %></td>
              </tr>
              <tr>
                <td>Весовая логистика РБ:</td>
                <td class="text-right">+ <%= number_to_currency(@calculation[:belarus_delivery_zl], unit: 'PLN', format: '%n %u', precision: 2) %></td>
              </tr>
              <tr class="table-info">
                <td><strong>ИТОГО (PLN):</strong></td>
                <td class="text-right"><strong><%= number_to_currency(@calculation[:total_pln], unit: 'PLN', format: '%n %u', precision: 2) %></strong></td>
              </tr>
            </table>

            <div class="card border-primary mb-4">
              <div class="card-body bg-light">
                <h5 class="card-title">Итоговая формула (BYN):</h5>
                <p class="card-text mb-0">
                  <code><%= number_with_precision(@calculation[:total_pln], precision: 2) %> PLN × <%= number_with_precision(@calculation[:pln_rate], precision: 4) %> (курс НБ) × <%= number_with_precision(@calculation[:exchange_rate_buffer], precision: 4) %> (буфер) = 
                  <%= number_to_currency(@calculation[:total_price_byn], unit: 'BYN', format: '%n %u', precision: 2) %></code>
                </p>
                <small class="text-muted">Эквивалентно: сумма_PLN × <%= number_with_precision(@calculation[:pln_rate_with_buffer], precision: 4) %> (курс с буфером).</small>
              </div>
            </div>

            <div class="mt-4">
              <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#customsDetails">
                Показать информацию о таможне (справочно)
              </button>
              <div class="collapse mt-3" id="customsDetails">
                <div class="card card-body">
                  <h6>Таможенная пошлина (не включена в итоговую цену):</h6>
                  <table class="table table-sm table-bordered mb-0">
                    <tr>
                      <td>Пошлина (EUR):</td>
                      <td class="text-right"><%= number_to_currency(@calculation[:customs_duty_eur], unit: 'EUR', format: '%n %u', precision: 2) %></td>
                    </tr>
                    <tr>
                      <td>Сбор (BYN):</td>
                      <td class="text-right"><%= number_to_currency(@calculation[:customs_fee_byn], unit: 'BYN', format: '%n %u', precision: 2) %></td>
                    </tr>
                    <tr class="table-warning">
                      <td><strong>Итого пошлина (BYN):</strong></td>
                      <td class="text-right"><strong><%= number_to_currency(@calculation[:customs_total_byn], unit: 'BYN', format: '%n %u', precision: 2) %></strong></td>
                    </tr>
                  </table>
                  <small class="text-muted mt-2">
                    Внимание: В данной логике таможенная пошлина не прибавляется к стоимости товара автоматически.
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
