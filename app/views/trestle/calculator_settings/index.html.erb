<% content_for :toolbar do %>
  <div class="btn-toolbar">
    <%= form_tag admin.path(:initialize_defaults), method: :post, data: { turbo: false }, class: "form-inline" do %>
      <%= submit_tag "Инициализировать настройки по умолчанию", class: "btn btn-primary",
          data: { confirm: "Будут созданы только отсутствующие настройки. Уже заданные администратором значения не изменятся. Продолжить?" } %>
    <% end %>
  </div>
<% end %>

