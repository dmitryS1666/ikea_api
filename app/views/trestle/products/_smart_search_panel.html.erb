<div id="trestle-smart-search-panel" class="card mb-4">
  <div class="card-body">
    <% if current_user.allowed_for_admin_resource?(:products, :build_products_xlsx) %>
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <% status_label = Admin::ProductsXlsxExportService.export_status_label %>
      <% if status_label.present? %>
        <span class="text-warning small"><%= status_label %></span>
      <% elsif Admin::ProductsXlsxExportService.export_ready? %>
        <%= link_to "⬇️ Скачать выгрузку товаров (XLSX)",
                    admin.path(:download_products_xlsx),
                    class: "btn btn-primary",
                    data: { turbo: false } %>
        <span class="text-muted small">
          обновлён <%= Admin::ProductsXlsxExportService.exported_at.strftime("%d.%m.%Y %H:%M") %>
        </span>
      <% else %>
        <span class="text-muted small">Файла выгрузки XLSX пока нет — сформируйте кнопкой справа.</span>
      <% end %>

      <%= form_tag admin.path(:build_products_xlsx), method: :post, class: "d-inline", data: { turbo: false } do %>
        <%= submit_tag Admin::ProductsXlsxExportService.building? ? "⏳ Выгрузка…" : "📊 Сформировать XLSX (все товары)",
                      class: "btn btn-outline-primary",
                      disabled: Admin::ProductsXlsxExportService.building?,
                      data: { confirm: "Запустить полную выгрузку в фоне? Предыдущий файл XLSX будет заменён после завершения." } %>
      <% end %>

      <% unless Admin::ProductsXlsxExportService.building? %>
        <%= form_tag admin.path(:reset_products_xlsx_export), method: :post, class: "d-inline", data: { turbo: false } do %>
          <%= submit_tag "Сбросить блокировку выгрузки",
                        class: "btn btn-outline-warning btn-sm",
                        data: { confirm: "Сбросить lock и сообщения об ошибке? Используйте только если выгрузка зависла (нет прогресса в Sidekiq)." } %>
        <% end %>
      <% end %>

      <%= form_tag admin.path(:build_products_xlsx), method: :post, class: "d-inline", data: { turbo: false } do %>
        <%= hidden_field_tag :limit, 5 %>
        <%= submit_tag "📊 Тест: XLSX (5 товаров)",
                      class: "btn btn-outline-secondary",
                      data: { confirm: "Сформировать тестовую выгрузку из 5 товаров? Текущий файл XLSX будет заменён." } %>
      <% end %>
    </div>
    <% end %>

    <div class="d-flex gap-2 flex-wrap mt-2">
      <% if current_user.allowed_for_admin_resource?(:products, :export_extended_attrs_input) %>
      <%= link_to "⬇️ Выгрузить JSON для парсера расширенных атрибутов",
                  admin.path(:export_extended_attrs_input),
                  class: "btn btn-outline-primary",
                  data: { turbo: false } %>
      <% end %>

      <%= form_tag admin.path(:import_extended_attrs),
                  method: :post,
                  multipart: true,
                  class: "d-flex gap-2 align-items-center",
                  data: { turbo: false } do %>
        <%= file_field_tag :file, accept: "application/json", class: "form-control", style: "max-width: 340px;" %>
        <div class="form-check form-check-inline">
          <%= check_box_tag :force_full, "1", false, class: "form-check-input", id: "force_full_import" %>
          <%= label_tag :force_full, "Полное обновление", class: "form-check-label", for: "force_full_import" %>
        </div>
        <%= submit_tag "⬆️ Загрузить атрибуты (JSON)",
                      class: "btn btn-success",
                      data: { confirm: "Загрузить и обновить продукты из JSON файла?" } %>
      <% end %>
    </div>

    <div class="d-flex gap-2 flex-wrap mt-2">
      <%= form_tag admin.path(:import_bestsellers_csv),
                  method: :post,
                  multipart: true,
                  class: "d-flex gap-2 align-items-center",
                  data: { turbo: false } do %>
        <%= file_field_tag :file, accept: ".csv", class: "form-control", style: "max-width: 250px;" %>
        <%= submit_tag "⬆️ Загрузить Хиты Продаж (CSV)",
                      class: "btn btn-outline-success" %>
      <% end %>

      <%= form_tag admin.path(:import_new_arrivals_csv),
                  method: :post,
                  multipart: true,
                  class: "d-flex gap-2 align-items-center",
                  data: { turbo: false } do %>
        <%= file_field_tag :file, accept: ".csv", class: "form-control", style: "max-width: 250px;" %>
        <%= submit_tag "⬆️ Загрузить Новинки (CSV)",
                      class: "btn btn-outline-success" %>
      <% end %>
    </div>

    <div class="d-flex gap-2 flex-wrap mt-2">
      <%= form_tag admin.path(:import_popular_csv),
                  method: :post,
                  multipart: true,
                  class: "d-flex gap-2 align-items-center",
                  data: { turbo: false } do %>
        <%= file_field_tag :file, accept: ".csv", class: "form-control", style: "max-width: 250px;" %>
        <%= submit_tag "⬆️ Загрузить Популярные (CSV)",
                      class: "btn btn-outline-success" %>
      <% end %>

      <%= form_tag admin.path(:import_recommended_csv),
                  method: :post,
                  multipart: true,
                  class: "d-flex gap-2 align-items-center",
                  data: { turbo: false } do %>
        <%= file_field_tag :file, accept: ".csv", class: "form-control", style: "max-width: 250px;" %>
        <%= submit_tag "⬆️ Загрузить Рекомендованные (CSV)",
                      class: "btn btn-outline-success" %>
      <% end %>
    </div>
  </div>

  <hr>

  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h3 class="h5 m-0">Умный поиск</h3>
      <span class="text-muted small">Algolia-like</span>
    </div>

    <form id="trestle-smart-search-form" class="search-form" action="<%= admin.path(:index) %>" method="get">
      <div class="input-group">
        <input type="search"
               name="q"
               class="form-control"
               value="<%= params[:q] %>"
               placeholder="Введите текст для поиска…"
               autocomplete="off" />
        <% if params[:q].present? %>
          <%= link_to admin.path(:index), class: "btn btn-outline-secondary", title: "Очистить поиск" do %>
            <i class="fa fa-times"></i>
          <% end %>
        <% end %>
        <button type="submit" class="btn btn-primary">Искать</button>
      </div>
    </form>

    <div id="trestle-smart-search-results" class="mt-3">
      <p class="text-muted small mb-0">Результаты появятся после поиска.</p>
    </div>
  </div>
</div>

<style>
  #trestle-smart-search-panel .smart-search-section {
    margin-top: 0.8rem;
  }

  #trestle-smart-search-panel .smart-search-section ul {
    margin: 0;
    padding-left: 1rem;
  }

  #trestle-smart-search-panel .smart-search-section li {
    margin-bottom: 0.25rem;
  }
</style>

<script>
  (function() {
    var panel = document.getElementById('trestle-smart-search-panel');
    if (!panel) return;

    var form = document.getElementById('trestle-smart-search-form');
    var results = document.getElementById('trestle-smart-search-results');

    form.addEventListener('submit', function(event) {
      // Убираем event.preventDefault(), чтобы форма отправлялась на сервер для фильтрации таблицы
      // Но оставляем логику для отображения подсказок, если нужно
      
      var query = form.querySelector('input[name="q"]').value.trim();
      if (!query) return;

      // Если хотим оставить и подсказки, и фильтрацию таблицы:
      // fetch('/api/v1/search/suggest?q=' + encodeURIComponent(query), ... )
    });

    function buildSections(data) {
      var sections = [];

      if (Array.isArray(data.suggestions) && data.suggestions.length) {
        sections.push(renderSection('Подсказки', renderList(data.suggestions.map(function(item) {
          return escapeHtml(item);
        }))));
      }

      if (data.categories && Array.isArray(data.categories.data)) {
        var categories = data.categories.data.map(function(item) {
          var attrs = item.attributes || {};
          return escapeHtml(attrs.translated_name || attrs.ikea_id || '');
        }).filter(Boolean);

        if (categories.length) {
          sections.push(renderSection('Категории', renderList(categories)));
        }
      }

      if (data.products && Array.isArray(data.products.data)) {
        var products = data.products.data.map(function(item) {
          var attrs = item.attributes || {};
          return escapeHtml(attrs.name_ru || attrs.name || attrs.sku || '');
        }).filter(Boolean);

        if (products.length) {
          sections.push(renderSection('Товары', renderList(products)));
        }
      }

      if (Array.isArray(data.popular_queries) && data.popular_queries.length) {
        sections.push(renderSection('Популярные запросы', renderList(data.popular_queries.map(function(entry) {
          var label = entry.query || '';
          if (entry.weight) {
            label += ' (' + entry.weight + ')';
          }
          return escapeHtml(label);
        }))));
      }

      if (!sections.length) {
        return '<p class="text-muted small mb-0">Результаты не найдены.</p>';
      }

      return sections.join('');
    }

    function renderSection(title, body) {
      return '<div class="smart-search-section">' +
               '<strong>' + escapeHtml(title) + '</strong>' +
               '<div class="mt-1">' + body + '</div>' +
             '</div>';
    }

    function renderList(items) {
      return '<ul class="list-unstyled mb-0">' +
               items.map(function(item) {
                 return '<li>' + item + '</li>';
               }).join('') +
             '</ul>';
    }

    function escapeHtml(value) {
      var div = document.createElement('div');
      div.textContent = value;
      return div.innerHTML;
    }
  })();
</script>
