<% content_for :page_title do %>
  <%= @product.name %>
<% end %>

<div class="product-show">
  <div class="mb-3">
    <%= link_to edit_products_admin_path(@product), class: "btn btn-primary", data: { turbo: false } do %>
      <i class="fa fa-pencil"></i> Редактировать
    <% end %>
  </div>
  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Главный баннер</h5>
        </div>
        <div class="card-body">
          <table class="table">
            <tr>
              <th>SKU:</th>
              <td><%= @product.sku %></td>
            </tr>
            <% if @product.item_no.present? %>
              <tr>
                <th>Артикул IKEA (Item No):</th>
                <td><%= @product.item_no %></td>
              </tr>
            <% end %>
            <% if @product.url.present? %>
              <tr>
                <th>URL:</th>
                <td>
                  <%= link_to @product.url, @product.url, target: '_blank' %>
                </td>
              </tr>
            <% end %>
            <% if @product.name_ru.present? %>
              <tr>
                <th>Название:</th>
                <td><%= @product.name_ru %><br><%= @product.small_desc_name %></td>
              </tr>
            <% end %>
            <% if @product.collection.present? %>
              <tr>
                <th>Коллекция:</th>
                <td><%= @product.collection %></td>
              </tr>
            <% end %>
            <% if @product.category.present? %>
              <tr>
                <th>Категория:</th>
                <td>
                  <%= link_to @product.category.translated_name, categories_admin_path(@product.category.ikea_id), class: 'text-decoration-none' %>
                </td>
              </tr>
            <% end %>
            <% if @product.price.present? %>
              <tr>
                <th>Цена:</th>
                <td><%= number_to_currency(@product.price, unit: 'PLN', format: '%n %u') %></td>
              </tr>
            <% end %>
            <% if @product.quantity.present? %>
              <tr>
                <th>В наличии:</th>
                <td><%= @product.quantity %></td>
              </tr>
            <% end %>
            <tr>
              <th>Хит продаж:</th>
              <td>
                <span class="badge <%= @product.is_bestseller? ? 'badge-success' : 'badge-secondary' %>">
                  <%= @product.is_bestseller? ? 'Да' : 'Нет' %>
                </span>
              </td>
            </tr>
            <tr>
              <th>Популярный:</th>
              <td>
                <span class="badge <%= @product.is_popular? ? 'badge-success' : 'badge-secondary' %>">
                  <%= @product.is_popular? ? 'Да' : 'Нет' %>
                </span>
              </td>
            </tr>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Характеристики</h5>
        </div>
        <div class="card-body">
          <table class="table">
            <% if @product.weight.present? %>
              <tr>
                <th>Вес:</th>
                <td><%= "#{@product.weight} кг" %></td>
              </tr>
            <% end %>
            <% if @product.net_weight.present? %>
              <tr>
                <th>Чистый вес:</th>
                <td><%= "#{@product.net_weight} кг" %></td>
              </tr>
            <% end %>
            <% if @product.package_volume.present? %>
              <tr>
                <th>Объём упаковки:</th>
                <td><%= "#{@product.package_volume} л" %></td>
              </tr>
            <% end %>
            <% if @product.package_dimensions.present? %>
              <tr>
                <th>Размеры упаковки:</th>
                <td><%= @product.package_dimensions %></td>
              </tr>
            <% end %>
            <% if @product.dimensions.present? %>
              <tr>
                <th>Размеры:</th>
                <td><%= @product.dimensions %></td>
              </tr>
            <% end %>
            <% if @product.materials_ru.present? %>
              <tr>
                <th>Материалы (RU):</th>
                <td><%= @product.materials_ru %></td>
              </tr>
            <% end %>
            <% if @product.features_ru.present? %>
              <tr>
                <th>Особенности (RU):</th>
                <td><%= @product.features_ru %></td>
              </tr>
            <% end %>
            <% if @product.care_instructions_ru.present? %>
              <tr>
                <th>Инструкции по уходу:</th>
                <td><%= @product.care_instructions_ru %></td>
              </tr>
            <% end %>
            <% if @product.environmental_info.present? %>
              <tr>
                <th>Экологическая информация (PL):</th>
                <td><%= @product.environmental_info %></td>
              </tr>
            <% end %>
            <% if @product.environmental_info_ru.present? %>
              <tr>
                <th>Экологическая информация (RU):</th>
                <td><%= @product.environmental_info_ru %></td>
              </tr>
            <% end %>
            <% if @product.short_description_ru.present? %>
              <tr>
                <th>Краткое описание (RU):</th>
                <td><%= @product.short_description_ru %></td>
              </tr>
            <% end %>
            <% if @product.designer.present? %>
              <tr>
                <th>Дизайнер:</th>
                <td><%= @product.designer %></td>
              </tr>
            <% end %>
            <% if @product.good_info.present? %>
              <tr>
                <th>Полезно знать:</th>
                <td><%= @product.good_info %></td>
              </tr>
            <% end %>
            <% if @product.good_info_ru.present? %>
              <tr>
                <th>Полезно знать:</th>
                <td><%= @product.good_info_ru %></td>
              </tr>
            <% end %>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5>Картинки продукта</h5>
        </div>
        <div class="card-body">
          <% 
            # Получаем remote images
            remote_images = if @product.images.is_a?(Array)
                              @product.images
                            elsif @product.images.is_a?(String) && @product.images.present?
                              begin
                                JSON.parse(@product.images)
                              rescue
                                []
                              end
                            else
                              []
                            end
            # Фильтруем пустые, nil, false и строку "false" значения
            remote_images = Array(remote_images).compact.reject { |url| 
              url.blank? || 
              url == false || 
              url == 'false' || 
              !url.is_a?(String) ||
              url.to_s.downcase == 'false'
            }

            # Получаем local images
            local_images = if @product.local_images.is_a?(Array)
                             @product.local_images
                           elsif @product.local_images.is_a?(String) && @product.local_images.present?
                             begin
                               parsed = JSON.parse(@product.local_images)
                               # Если это массив массивов, распаковываем
                               parsed.is_a?(Array) ? parsed.flatten : [parsed]
                             rescue
                               []
                             end
                           else
                             []
                           end
            # Фильтруем и нормализуем пути - гарантируем, что каждый элемент это строка
            local_images = Array(local_images).flatten.compact.flat_map { |path|
              # Преобразуем в строку
              path_str = path.to_s.strip
              
              # Если это JSON-строка с массивом, парсим её
              if path_str.start_with?('[') && path_str.end_with?(']')
                begin
                  parsed = JSON.parse(path_str)
                  # Если это массив, возвращаем все элементы
                  parsed.is_a?(Array) ? parsed : [path_str]
                rescue
                  # Если не JSON, убираем кавычки и скобки
                  cleaned = path_str.gsub(/^["\[\]]+|["\[\]]+$/, '').strip
                  cleaned.present? ? [cleaned] : []
                end
              else
                # Убираем кавычки и скобки, если они есть
                cleaned = path_str.gsub(/^["\[\]]+|["\[\]]+$/, '').strip
                cleaned.present? ? [cleaned] : []
              end
            }.reject { |path_str|
              # Отфильтровываем пустые, false, 'false', и строки с запятыми (массивы)
              path_str.blank? || 
              path_str == false || 
              path_str == 'false' || 
              path_str.to_s.downcase == 'false' ||
              !path_str.is_a?(String) ||
              path_str.include?(',') || # Массив в строке
              path_str.include?('","') || # JSON-массив в строке
              path_str.include?('%22')   # URL-encoded кавычки
            }
          %>

          <% if remote_images.any? || local_images.any? %>
            <% if remote_images.any? %>
              <h6 class="mt-3">Удалённые картинки (IKEA) (<%= remote_images.length %>)</h6>
              <div class="mb-4">
                <ul class="list-unstyled">
                  <% remote_images.each_with_index do |image_url, index| %>
                    <li class="mb-1">
                      <%= link_to "#{index + 1}: #{image_url}", image_url, target: '_blank', class: 'text-break' %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <% if local_images.any? %>
              <h6 class="mt-3">Локальные картинки (<%= local_images.length %>)</h6>
              <div class="row mb-4">
                <% local_images.each do |image_path| %>
                  <% 
                    # Строгая обработка image_path - гарантируем, что это строка
                    # Если это массив, берем первый элемент
                    if image_path.is_a?(Array)
                      image_path = image_path.first
                    end
                    
                    # Преобразуем в строку и убираем кавычки и скобки
                    image_path = image_path.to_s.strip
                    image_path = image_path.gsub(/^["\[\]]+|["\[\]]+$/, '').strip
                    
                    # Пропускаем если пусто, не строка, или содержит запятые/кавычки (массив)
                    next if image_path.blank? || 
                            !image_path.is_a?(String) ||
                            image_path.include?(',') ||
                            image_path.include?('","') ||
                            image_path.include?('%22')
                    
                    # Формируем полный путь
                    full_path = image_path.start_with?('/') ? image_path : "/#{image_path}"
                    
                    # Финальная проверка - full_path должен быть строкой без запятых
                    next unless full_path.is_a?(String) && 
                                full_path.present? && 
                                !full_path.include?(',') &&
                                !full_path.include?('%22')
                  %>
                  <div class="col-sm-3 col-md-2 mb-3">
                    <div class="product-image-thumbnail" style="border: 1px solid #ddd; border-radius: 4px; padding: 5px; text-align: center;">
                      <%= link_to full_path.to_s, target: '_blank', title: image_path do %>
                        <%= image_tag(full_path.to_s, class: 'img-fluid', style: 'max-width: 100%; height: auto;', onerror: "this.style.display='none'; this.parentElement.innerHTML='<em class=\\'text-muted\\'>Ошибка загрузки</em>';") %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted">Картинки не загружены</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% 
    # Варианты: SKU из колонки variants (+ текущий товар для контекста группы)
    variant_skus = ([@product.sku.to_s] + @product.normalized_variant_skus).map(&:to_s).uniq
    variant_skus = variant_skus.partition { |s| s == @product.sku.to_s }.flatten

    variants_raw = if @product.variants.is_a?(Array)
                   @product.variants
                 elsif @product.variants.is_a?(String) && @product.variants.present?
                   begin
                     JSON.parse(@product.variants)
                   rescue
                     []
                   end
                 else
                   []
                 end

    # Получаем связанные продукты
    related_products = if @product.related_products.is_a?(Array)
                         @product.related_products
                       elsif @product.related_products.is_a?(String) && @product.related_products.present?
                         begin
                           JSON.parse(@product.related_products)
                         rescue
                           []
                         end
                       else
                         []
                       end
    
    included_products = Array(@product.included_products).filter_map { |sku| sku.to_s.gsub(/[\[\]\"]/, '').strip.presence }.uniq

    show_related_block =
      variant_skus.many? ||
      variants_raw.any? ||
      related_products.any? ||
      included_products.any?
  %>
  
  <% if show_related_block %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5>Связанные продукты</h5>
          </div>
          <div class="card-body">
            <h6 class="mb-3">Варианты (<code>variants</code> → SKU, <%= variant_skus.size %>)</h6>
            <div class="mb-4">
              <% if variant_skus.many? %>
                <ul class="list-group">
                  <% variant_skus.each do |v_sku| %>
                    <% v_product = Product.find_by(sku: v_sku) || Product.find_by(item_no: v_sku.to_s.gsub(/\D/, "").presence) %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <% if v_product %>
                        <%= link_to "#{v_product.name} (#{v_sku})", "/admin/products/#{v_product.id}", class: 'text-decoration-none' %>
                        <span>
                          <% if v_sku.to_s == @product.sku.to_s %>
                            <span class="badge badge-info badge-pill">текущий</span>
                          <% end %>
                          <% if v_product.price %>
                            <span class="badge badge-primary badge-pill"><%= number_to_currency(v_product.price, unit: 'PLN', format: '%n %u') %></span>
                          <% end %>
                        </span>
                      <% else %>
                        <span><%= v_sku %></span>
                        <span>
                          <% if v_sku.to_s == @product.sku.to_s %>
                            <span class="badge badge-info badge-pill">текущий</span>
                          <% end %>
                          <span class="badge badge-secondary badge-pill">Не найден</span>
                        </span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% elsif variants_raw.any? %>
                <p class="text-muted small mb-2">Не удалось свести к SKU; сырые элементы <code>variants</code> (<%= variants_raw.size %>):</p>
                <ul class="list-group">
                  <% variants_raw.each do |entry| %>
                    <li class="list-group-item"><pre class="mb-0 small" style="white-space: pre-wrap;"><%= entry.is_a?(Hash) ? JSON.pretty_generate(entry) : h(entry.to_s) %></pre></li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-muted mb-0">В данных нет других вариантов (колонка <code>variants</code> пуста или один SKU).</p>
              <% end %>
            </div>

            <% if related_products.any? %>
              <h6 class="mb-3">Рекомендуемые (<code>related_products</code>, <%= related_products.length %>)</h6>
              <div class="mb-4">
                <ul class="list-group">
                  <% related_products.each do |item| %>
                    <% item_no = item.is_a?(Hash) ? (item["sku"] || item[:sku] || item["item_no"] || item[:item_no]) : item %>
                    <% related_product = Product.find_by(item_no: item_no) || Product.find_by(sku: item_no) %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <% if related_product %>
                        <%= link_to "#{related_product.name} (#{item_no})", "/admin/products/#{related_product.id}", class: 'text-decoration-none' %>
                        <span class="badge badge-primary badge-pill"><%= related_product.price ? number_to_currency(related_product.price, unit: 'PLN', format: '%n %u') : 'N/A' %></span>
                      <% else %>
                        <span><%= item_no %></span>
                        <span class="badge badge-secondary badge-pill">Не найден</span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            
            <% if included_products.any? %>
              <h6 class="mb-3">Товары в наборе (<code>included_products</code>, <%= included_products.length %>)</h6>
              <div class="mb-4">
                <ul class="list-group">
                  <% included_products.each do |item_no| %>
                    <% set_product = Product.find_by(item_no: item_no) || Product.find_by(sku: item_no) %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <% if set_product %>
                        <%= link_to "#{set_product.name} (#{item_no})", "/admin/products/#{set_product.id}", class: 'text-decoration-none' %>
                        <span class="badge badge-primary badge-pill"><%= set_product.price ? number_to_currency(set_product.price, unit: 'PLN', format: '%n %u') : 'N/A' %></span>
                      <% else %>
                        <span><%= item_no %></span>
                        <span class="badge badge-secondary badge-pill">Не найден</span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if @product.delivery_type.present? || @product.delivery_name.present? || @product.delivery_cost.present? %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h5>Доставка</h5>
          </div>
          <div class="card-body">
            <table class="table">
              <% if @product.delivery_type.present? %>
                <tr>
                  <th>Тип доставки:</th>
                  <td><%= @product.delivery_type %></td>
                </tr>
              <% end %>
              <% if @product.delivery_name.present? %>
                <tr>
                  <th>Название доставки:</th>
                  <td><%= @product.delivery_name %></td>
                </tr>
              <% end %>
              <% if @product.delivery_cost.present? %>
                <tr>
                  <th>Стоимость доставки:</th>
                  <td><%= number_to_currency(@product.delivery_cost, unit: 'PLN', format: '%n %u') %></td>
                </tr>
              <% end %>
              <% if @product.delivery_reason.present? %>
                <tr>
                  <th>Причина доставки:</th>
                  <td><%= @product.delivery_reason %></td>
                </tr>
              <% end %>
            </table>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  .product-image-thumbnail {
    transition: transform 0.2s;
  }
  .product-image-thumbnail:hover {
    transform: scale(1.05);
  }
  .product-image-thumbnail img {
    cursor: pointer;
  }
</style>

