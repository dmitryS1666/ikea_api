<% content_for :page_title do %>
  Категории
<% end %>

<% content_for :main_actions do %>
  <%= link_to new_categories_admin_path("category[is_custom]": true), class: "btn btn-primary" do %>
    <i class="fa fa-plus"></i> Добавить кастомную категорию
  <% end %>
<% end %>

<div class="row">
  <div class="col-md-2">
    <div class="card mb-3">
      <div class="card-header">Переиндексация</div>
      <div class="card-body">
        <%= form_tag admin.path(:reindex_all_filters),
                    method: :post,
                    data: { turbo: false, confirm: "Переиндексировать фильтры для всех категорий?" } do %>
          <%= submit_tag "Переиндексировать все",
                        class: "btn btn-outline-success btn-sm w-100",
                        disabled: @filters_reindex_running %>
        <% end %>
        <% if @filters_reindex_task %>
          <div class="small text-muted mt-2">
            Статус: <strong><%= @filters_reindex_task.status %></strong><br>
            Начало: <%= @filters_reindex_task.started_at&.strftime('%Y-%m-%d %H:%M') || '-' %><br>
            Завершение: <%= @filters_reindex_task.completed_at&.strftime('%Y-%m-%d %H:%M') || '-' %><br>
            Обработано: <%= @filters_reindex_task.processed %><br>
            Ошибок: <%= @filters_reindex_task.error_count %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="card mb-3">
      <div class="card-header">Импорт фильтров</div>
      <div class="card-body">
        <%= form_tag admin.path(:import_available_filters),
                    method: :post,
                    multipart: true,
                    data: { turbo: false } do %>
          <%= file_field_tag :file, accept: "application/json", class: "form-control mb-2" %>
          <%= submit_tag "Загрузить available_filters",
                        class: "btn btn-success btn-sm",
                        data: { confirm: "Загрузить available_filters из JSON файла?" } %>
          <div class="text-muted small mt-2">
            JSON: объект, массив, { categories: [...] } или JSONL.
          </div>
        <% end %>
      </div>
    </div>
    <div class="sidebar-section card">
      <div class="card-header">Фильтры</div>
      <div class="list-group list-group-flush">
        <%= link_to "Все", { scope: 'all' }, class: "list-group-item list-group-item-action #{'active' if @current_scope == 'all'}" %>
        <%= link_to "ТОП-категории", { scope: 'top' }, class: "list-group-item list-group-item-action #{'active' if @current_scope == 'top'}" %>
        <%= link_to "Кастомные (Спецпредложения)", { scope: 'custom' }, class: "list-group-item list-group-item-action #{'active' if @current_scope == 'custom'}" %>
        <%= link_to "Верхнеуровневые", { scope: 'top_level' }, class: "list-group-item list-group-item-action #{'active' if @current_scope == 'top_level'}" %>
        <%= link_to "Популярные", { scope: 'popular' }, class: "list-group-item list-group-item-action #{'active' if @current_scope == 'popular'}" %>
        <%= link_to "Активные", { scope: 'active' }, class: "list-group-item list-group-item-action #{'active' if @current_scope == 'active'}" %>
      </div>
    </div>
  </div>

  <div class="col-md-10">
    <div class="categories-tree-container card">
      <div class="card-body">
        <div class="tree-controls mb-3">
          <%= link_to new_categories_admin_path("category[is_custom]": true), class: "btn btn-sm btn-primary" do %>
            <i class="fa fa-plus"></i> Создать кастомную страницу
          <% end %>
          <button type="button" class="btn btn-sm btn-secondary" onclick="expandAll()">
            <i class="fa fa-plus-circle"></i> Развернуть все
          </button>
          <button type="button" class="btn btn-sm btn-secondary" onclick="collapseAll()">
            <i class="fa fa-minus-circle"></i> Свернуть все
          </button>
        </div>

        <div class="categories-tree">
          <% if @categories_tree.any? %>
            <%= render partial: 'trestle/categories/category_node', collection: @categories_tree, as: :node %>
          <% else %>
            <div class="alert alert-info">Категории не найдены</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .categories-tree-container {
    padding: 0;
  }
  .sidebar-section {
    position: sticky;
    top: 20px;
  }
  /* ... существующие стили ... */

  .tree-controls {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .category-node {
    margin-left: 0;
    margin-bottom: 5px;
  }

  .category-item {
    display: flex;
    align-items: center;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    margin-bottom: 5px;
    transition: background-color 0.2s;
  }

  .category-item:hover {
    background-color: #f5f5f5;
  }

  .category-item.disabled {
    opacity: 0.6;
    background-color: #f9f9f9;
  }

  .category-toggle {
    cursor: pointer;
    margin-right: 10px;
    width: 20px;
    text-align: center;
    user-select: none;
    color: #666;
  }

  .category-toggle:hover {
    color: #333;
  }

  .category-toggle.has-children::before {
    content: '▶';
    display: inline-block;
    transition: transform 0.2s;
  }

  .category-toggle.has-children.expanded::before {
    transform: rotate(90deg);
  }

  .category-toggle.no-children {
    color: #ccc;
  }

  .category-info {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .category-name {
    font-weight: 500;
    color: #333;
  }

  .category-name.disabled {
    color: #999;
    text-decoration: line-through;
  }

  .category-id {
    font-size: 0.85em;
    color: #666;
    font-family: monospace;
  }

  .category-badges {
    display: flex;
    gap: 5px;
  }

  .badge {
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 0.75em;
  }

  .badge-popular {
    background-color: #28a745;
    color: white;
  }

  .badge-top {
    background-color: #17a2b8;
    color: white;
  }

  .badge-custom {
    background-color: #6f42c1;
    color: white;
  }

  .badge-disabled {
    background-color: #dc3545;
    color: white;
  }

  .category-stats {
    font-size: 0.85em;
    color: #666;
  }

  .category-actions {
    display: flex;
    gap: 5px;
    margin-left: auto;
  }

  .category-actions .btn {
    padding: 4px 8px;
    font-size: 0.85em;
  }

  .category-children {
    margin-left: 30px;
    margin-top: 5px;
    display: none;
  }

  .category-children.expanded {
    display: block;
  }

  .indent-level-1 { margin-left: 30px; }
  .indent-level-2 { margin-left: 60px; }
  .indent-level-3 { margin-left: 90px; }
  .indent-level-4 { margin-left: 120px; }
  .indent-level-5 { margin-left: 150px; }
</style>

<script>
  // Функции должны быть доступны глобально
  window.toggleCategory = function(nodeId) {
    const children = document.getElementById(`children-${nodeId}`);
    const toggle = document.getElementById(`toggle-${nodeId}`);
    
    if (children) {
      children.classList.toggle('expanded');
      if (toggle) {
        toggle.classList.toggle('expanded');
      }
    }
  };

  window.expandAll = function() {
    const children = document.querySelectorAll('.category-children');
    const toggles = document.querySelectorAll('.category-toggle.has-children');
    
    children.forEach(el => {
      el.classList.add('expanded');
    });
    toggles.forEach(el => {
      el.classList.add('expanded');
    });
    
    console.log('Expanded all:', children.length, 'categories');
  };

  window.collapseAll = function() {
    const children = document.querySelectorAll('.category-children');
    const toggles = document.querySelectorAll('.category-toggle.has-children');
    
    children.forEach(el => {
      el.classList.remove('expanded');
    });
    toggles.forEach(el => {
      el.classList.remove('expanded');
    });
    
    console.log('Collapsed all:', children.length, 'categories');
  };

  // Инициализация при загрузке страницы
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Categories tree initialized');
    // Убеждаемся, что функции доступны
    if (typeof window.expandAll === 'function' && typeof window.collapseAll === 'function') {
      console.log('Expand/Collapse functions are ready');
    }
  });
</script>

