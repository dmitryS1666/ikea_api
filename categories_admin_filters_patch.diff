   controller do
+    def add_filter_value
+      @category = admin.find_instance(params)
+
+      attrs = permitted_filter_value_attrs
+      attrs[:category_id] = @category.ikea_id.to_s if ProductFilterValue.column_names.include?("category_id")
+
+      pfv = ProductFilterValue.new(attrs)
+
+      if pfv.save
+        flash[:message] = "Фильтр добавлен."
+      else
+        flash[:error] = "Не удалось добавить фильтр: #{pfv.errors.full_messages.join(', ')}"
+      end
+
+      redirect_back fallback_location: edit_categories_admin_path(@category.ikea_id)
+    end
+
+    def update_filter_value
+      @category = admin.find_instance(params)
+      pfv = ProductFilterValue.find(params[:filter_value_id])
+
+      unless pfv_category_matches?(pfv, @category)
+        flash[:error] = "Фильтр не принадлежит этой категории."
+        return redirect_back fallback_location: edit_categories_admin_path(@category.ikea_id)
+      end
+
+      if pfv.update(permitted_filter_value_attrs)
+        flash[:message] = "Фильтр обновлен."
+      else
+        flash[:error] = "Не удалось обновить фильтр: #{pfv.errors.full_messages.join(', ')}"
+      end
+
+      redirect_back fallback_location: edit_categories_admin_path(@category.ikea_id)
+    end
+
+    def remove_filter_value
+      @category = admin.find_instance(params)
+      pfv = ProductFilterValue.find(params[:filter_value_id])
+
+      unless pfv_category_matches?(pfv, @category)
+        flash[:error] = "Фильтр не принадлежит этой категории."
+        return redirect_back fallback_location: edit_categories_admin_path(@category.ikea_id)
+      end
+
+      pfv.destroy
+      flash[:message] = "Фильтр удален."
+
+      redirect_back fallback_location: edit_categories_admin_path(@category.ikea_id)
+    end
+
+    private
+
+    def pfv_category_matches?(pfv, category)
+      return false unless ProductFilterValue.column_names.include?("category_id")
+
+      pfv.category_id.to_s == category.ikea_id.to_s
+    end
+
+    def permitted_filter_value_attrs
+      payload = params.fetch(:product_filter_value, {}).to_unsafe_h.symbolize_keys
+
+      allowed = ProductFilterValue.column_names & %w[
+        category_id
+        product_filter_id
+        filter_id
+        filter_key
+        filter_name
+        name
+        title
+        slug
+        code
+        value
+        value_ru
+        translated_value
+        position
+        sort_order
+        is_active
+      ]
+
+      payload.slice(*allowed.map(&:to_sym))
+    end
   end
