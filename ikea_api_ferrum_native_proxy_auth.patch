index 0000000..0fa4b31
--- /dev/null
+++ b/config/initializers/ferrum_native_proxy_auth.rb
@@ -0,0 +1,112 @@
+# frozen_string_literal: true
+
+# Ferrum/Chrome handles authenticated proxies more reliably through Ferrum's
+# native `proxy:` option than through the Chrome `--proxy-server` flag plus
+# extension/auth interception.
+#
+# Context: PlDetailsFetcher#fetch_modal_with_headless_browser builds
+# browser_options["proxy-server"] from ProxyRotator. With auth-proxies Chrome may
+# fail on the first navigation with `net::ERR_INVALID_AUTH_CREDENTIALS`, while
+# the same proxy works through Ferrum's native `proxy: { host:, port:, user:,
+# password: }` option.
+#
+# This initializer transparently converts a matching `browser_options["proxy-server"]`
+# into Ferrum's native `proxy:` option. It is intentionally narrow: it only acts
+# when a proxy from ENV["PROXY_LIST"] has the same host:port and credentials.
+
+require "uri"
+
+if defined?(Ferrum::Browser)
+  module FerrumNativeProxyAuth
+    class << self
+      def proxy_for(proxy_server)
+        endpoint = normalize_endpoint(proxy_server)
+        return if endpoint.nil? || endpoint.empty?
+
+        parsed_proxies.find do |proxy|
+          proxy[:endpoint] == endpoint
+        end
+      end
+
+      def parsed_proxies
+        raw_list = ENV.fetch("PROXY_LIST", "")
+        raw_list.split(",").filter_map do |raw|
+          parse_proxy(raw)
+        end
+      end
+
+      def parse_proxy(raw)
+        value = raw.to_s.strip
+        return if value.empty?
+
+        uri = URI.parse(value.include?("://") ? value : "http://#{value}")
+        host = uri.host.to_s.strip
+        port = uri.port
+
+        return if host.empty? || port.nil?
+
+        {
+          endpoint: "#{host}:#{port}",
+          host: host,
+          port: port,
+          user: uri.user,
+          password: uri.password
+        }
+      rescue URI::InvalidURIError
+        nil
+      end
+
+      def normalize_endpoint(raw)
+        value = raw.to_s.strip
+        return if value.empty?
+
+        value = value.sub(%r{\A[a-z][a-z0-9+.-]*://}i, "")
+        value = value.split("@").last.to_s
+        value = value.split("/").first.to_s
+        value = value.split("?").first.to_s
+        value.sub(/\A\[/, "").sub(/\]\z/, "")
+      end
+    end
+
+    def initialize(*args, **kwargs, &block)
+      browser_options = kwargs[:browser_options]
+      proxy_server = browser_options.is_a?(Hash) && browser_options["proxy-server"]
+
+      if kwargs[:proxy].nil? && proxy_server
+        proxy = FerrumNativeProxyAuth.proxy_for(proxy_server)
+
+        if proxy
+          patched_browser_options = browser_options.dup
+
+          # Do not pass Chrome's --proxy-server when using Ferrum's native proxy.
+          # Passing both may cause Chrome to ignore the native credentials and fail
+          # with ERR_INVALID_AUTH_CREDENTIALS.
+          patched_browser_options.delete("proxy-server")
+
+          # Older auth-extension workaround is not needed with native proxy and can
+          # break in headless/new mode. Keep every other browser option intact.
+          patched_browser_options.delete("load-extension")
+          patched_browser_options.delete("disable-extensions-except")
+
+          kwargs[:browser_options] = patched_browser_options
+          kwargs[:proxy] = {
+            host: proxy[:host],
+            port: proxy[:port],
+            user: proxy[:user],
+            password: proxy[:password]
+          }.compact
+
+          Rails.logger.debug(
+            "FerrumNativeProxyAuth: using native Ferrum proxy " \
+            "#{proxy[:endpoint]} auth=#{proxy[:user].to_s.empty? ? false : true}"
+          ) if defined?(Rails) && Rails.respond_to?(:logger) && Rails.logger
+        end
+      end
+
+      super(*args, **kwargs, &block)
+    end
+  end
+
+  Ferrum::Browser.prepend(FerrumNativeProxyAuth)
+end
